<div>
    Title: <input id="htmlTitle" type="text" />
    Html : <input id="htmlInput" type="text" />
    <button type="submit" id="htmlSubmit">Add</button>
</div>

<script>
    $(document).ready(function () {

        $("#htmlSubmit").click(function () {
            var inputHtmlData = document.getElementById('htmlInput').value;
            var inputTitleData = document.getElementById('htmlTitle').value;
            var dataa = { Title: inputTitleData, Html: inputHtmlData };
            $.ajax({
                url: '/HtmlInsert/Post', // Replace YourControllerName with the actual name of your controller
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(dataa),
                success: function (response) {
                    console.log(response);
                }
            });
        });
    });
       
</script>