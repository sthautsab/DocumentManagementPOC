@* Main Document View *@

@using DocumentsPOC.Dto
@model List<DocumentListDto>

   @*  <style>
    
    </style> *@

<div class="container">
    <div class="row">
        <div class="col-3">
            
            <ol id="documentList">
                @foreach(var doc in Model)
                {
                    var id = "documentId" + doc.Id;
                    <li id="@id">@doc.Title</li>
                }
            </ol>
        </div>
        <div class="col-6">
            <div>
                <button class="addDocBtn">Add To MyFolder</button>
                <button class="addPartialDocBtn">Add Selected Part</button>
                <input type="text" id="selectedPartialContentInput" style="display: none;">
            </div>
            <div id ="docContent" >

            </div>
        </div>
        <div class="col-3">
            <input type = "text" id="commentTxt"/>
            <button id="commentBtn">Add Comment</button>

            <hr />
            <div id="commentList">

            </div>
        </div>
    </div>
   
</div>

<script>
    $(document).ready(function () {
        var currentlySelectedDocumentId = null;
        $("#htmlSubmit").click(function () {
            var inputData = document.getElementById('htmlInput').value
            var dataa = { html: inputData };
            $.ajax({
                url: '@Url.Action("post", "htmlpost")',
                type: 'POST',
                
                contentType: 'application/json',
                data: JSON.stringify(dataa),
                success: function (response) {
                    console.log(inputData);
                }
            });
        });
        
        var listItems = document.querySelectorAll("#documentList li");
        listItems.forEach(function (item) {
            //Add click event listener to each list item
            item.addEventListener("click", function () {

                // Get the id of the clicked element
                var clickedItemId = item.id;
                var docId = clickedItemId.substring("documentId".length);

                // For keeping track of current document
                currentlySelectedDocumentId = docId;

                console.log("Currently selected docId",currentlySelectedDocumentId)

                handleDocumentListClick(docId);
            });
        });

        $(".addDocBtn").click(function () {
            $.ajax({
                url: '@Url.Action("AddDocumentToFolder")',
                type:'GET',
                data: {docId:currentlySelectedDocumentId, folderId:1},
                success: function (response) {
                    alert("Saved to MyFolder successfully");
                }
            });
        });

        //Selcted Portion Saving
        $(".addPartialDocBtn").click(function () {
            var selectedPart = getSelectedMarkup();
            if (selectedPart == null) {
                alert("select something");
            }
            else {
                document.getElementById("selectedPartialContentInput").value = selectedPart;

                
                var dataa = { ParentDocId: currentlySelectedDocumentId,
                    PartialContent: document.getElementById("selectedPartialContentInput").value,
                    FolderId: 1
                    };
                $.ajax({
                    url: '@Url.Action("AddPartialDocumentToFolder")',
                    type:'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dataa),
                    success: function (response) {
                        alert("Added Partial Content to folder");
                    }
                });
            }

        });


        $("#commentBtn").click(function () {
            console.log("clicked addComment")

            var selection = window.getSelection();
            if (!(selection.rangeCount > 0)) {
                alert("select something");
                return;
            }
            var range = selection.getRangeAt(0);

            var rangySerializedRange = rangy.serializeRange(range,true);
            var rangyDeserializedRange = rangy.deserializeRange(rangySerializedRange);


            //Create a new element to wrap the selected text
            var highlightSpan = document.createElement('span');
            highlightSpan.style.backgroundColor = 'yellow'; // Apply desired highlight color

            var clonedContent = rangyDeserializedRange.cloneContents();
            console.log(clonedContent)
            // range.surroundContents(highlightSpan);
            highlightSpan.appendChild(clonedContent);

            rangyDeserializedRange.deleteContents();
            // console.log(range.cloneContents());
            rangyDeserializedRange.insertNode(highlightSpan);


            var comment = document.getElementById("commentTxt").value;

            var data = { Range: rangySerializedRange, CommentContent: comment, DocumentId: currentlySelectedDocumentId };
            $.ajax({
                url: '@Url.Action("AddCommentOnDocument")',
                type:'POST',
                contentType:'application/json',
                data: JSON.stringify(data),
                success: function (response) {
                    alert("successfully added comment");
                }
            })
        })

        // Hide the button initially
        $(".addDocBtn").hide();
        $(".addPartialDocBtn").hide();
    });

    
    function handleDocumentListClick(id) {
        window.getSelection().removeAllRanges();

        console.log("Clicked item id is " + id);
        $(".addDocBtn").show();
        $(".addPartialDocBtn").show();
        $.ajax({
            url: '@Url.Action("GetDocumentContent")',
            type:'GET',
            data: {docId:id},
            success: function (response) {
                // console.log($("#docContent").innerHTML)
                $("#docContent").html(response.contentOutputDto.content);

                $("#commentList").html(generateCommentListHtml(response.rangeCommentInfo));




                //hightlight
                addHighlightForAllRanges(response.rangeCommentInfo);

                if (!response.contentOutputDto.isSelectable) {
                    document.getElementById("docContent").classList.add("unselectable");
                }
                else {
                    if (document.getElementById("docContent").classList.contains("unselectable")) {
                        document.getElementById("docContent").classList.remove("unselectable");
                    }
                }
            }
        })
    }

    

    function generateCommentListHtml(rangeCommentInfo) {
        var list = document.createElement("ul");

        rangeCommentInfo.forEach(function (info) {
            var listElement = document.createElement("li");
            listElement.classList.add("list_" + info.commentId);    //add a commentId with list_ prefix

            var textNode = document.createTextNode(info.commentContent);
            listElement.appendChild(textNode);

            var allHighlightedContentClassName = rangeCommentInfo.map(x => x.commentId);
            //Add Event
            listElement.addEventListener('click', function () {
                if(listElement.classList.contains("nowSelectedComment")){
                    listElement.classList.remove("nowSelectedComment");
                    return;
                }
                commentClickEvent(info.commentId, allHighlightedContentClassName);  //sends all the list of the commentId ie class for the highlighted content
            })

            list.appendChild(listElement);

        });
        return list;
    }

    //Add eventListener for the commentList
    function commentClickEvent(contentToHighlightClassName, allHighlightedContentClassName) {
        allHighlightedContentClassName.forEach(function (contentClass) {
            var content = document.getElementsByClassName(contentClass);
            if (contentToHighlightClassName != contentClass && content[0].classList.contains("nowSelected")) {
                content[0].classList.remove("nowSelected");
                content[0].setAttribute('style','background-color:yellow');
            }

            if (contentToHighlightClassName == contentClass && !content[0].classList.contains("nowSelected")) {
                content[0].removeAttribute('style');
                content[0].classList.add("nowSelected");
            }
        })
        

    }

    function addHighlightForAllRanges(rangeCommentInfo) {


        rangeCommentInfo.forEach(function (info) {
            deserializedRange = rangy.deserializeRange(info.range);

            //Create a new element to wrap the selected text
            var highlightSpan = document.createElement('span');
            highlightSpan.classList.add(info.commentId);
            highlightSpan.style.backgroundColor = 'yellow'; // Apply desired highlight color

            var allCommentsListElementClassName = rangeCommentInfo.map(x => ("list_"+x.commentId));
            highlightSpan.addEventListener('click', function () {
                if (highlightSpan.classList.contains("nowSelected")) {
                    highlightSpan.classList.remove("nowSelected");
                    highlightSpan.setAttribute('style', 'background-color:yellow');
                    return;
                }
                highlightedContentClickEvent("list_"+info.commentId, allCommentsListElementClassName)
                // showCommentContent(info.commentContent);
            });

            var clonedContent = deserializedRange.cloneContents();
            console.log(clonedContent)
            // range.surroundContents(highlightSpan);
            highlightSpan.appendChild(clonedContent);

            // clonedContent.surroundContents(highlightSpan);
            deserializedRange.deleteContents();
            // console.log(range.cloneContents());
            deserializedRange.insertNode(highlightSpan);

        })
    }

    //Add eventListener for the highlightedContent
    function highlightedContentClickEvent(selectedContentRelatedCommentListElementClassName, allCommentsListElementClassName) {
        allCommentsListElementClassName.forEach(function (commentClass) {
            var commentListElement = document.getElementsByClassName(commentClass);
            if (selectedContentRelatedCommentListElementClassName != commentClass && commentListElement[0].classList.contains("nowSelectedComment")) {
                commentListElement[0].classList.remove("nowSelectedComment");
                commentListElement[0].setAttribute('style', 'background-color:none');
            }

            if (selectedContentRelatedCommentListElementClassName == commentClass && !commentListElement[0].classList.contains("nowSelectedComment")) {
                commentListElement[0].removeAttribute('style');
                commentListElement[0].classList.add("nowSelectedComment");
            }

            // if (selectedContentRelatedCommentListElementClassName == commentClass && commentListElement[0].classList.contains("nowSelectedComment")) {
            //     commentListElement[0].removeAttribute('style');
            //     commentListElement[0].classList.remove("nowSelectedComment");
            // }
        })


    }
   

    function showCommentContent(comment) {
        alert("CommentContent: " + comment);
    }

    function getSelectedMarkup() {
        var selection = window.getSelection();
        if (selection.rangeCount > 0) {
            var range = selection.getRangeAt(0);
            // console.log(range)
            var container = document.createElement('div');
            container.appendChild(range.cloneContents());

            // console.log(container.innerHTML);
            var parent = range.commonAncestorContainer.parentNode;

            console.log("parent", parent)

            var elWithSelection = parent.cloneNode(false); // Cloning only the element, not its children
            elWithSelection.innerHTML = container.innerHTML;
            return elWithSelection.outerHTML;
        } else {
            return null;
        }
    }


</script>